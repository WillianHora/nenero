{
  "name": "nenero",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "start": "npm run start:mobile",
    "start:mobile": "npm --workspace @nenero/mobile run start",
    "android": "npm --workspace @nenero/mobile run android",
    "ios": "npm --workspace @nenero/mobile run ios",
    "start:web": "npm --workspace @nenero/web run start",
    "web": "npm run start:web",
    "export:web": "npm --workspace @nenero/web run export",
    "serve:web": "npm --workspace @nenero/web run serve",
    "typecheck": "npm run typecheck --workspaces --if-present"
  }
}
